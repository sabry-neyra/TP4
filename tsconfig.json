{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "types": ["node", "jest"],
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "api/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist", "frontend"]
}